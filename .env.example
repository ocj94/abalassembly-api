# ─── Copier en .env et remplir. NE JAMAIS committer .env ───

# Serveur
PORT=3000
NODE_ENV=production

# Origines autorisées (CORS) — séparées par des virgules
CORS_ORIGINS=https://ocj94.github.io,https://abalassembly.fr

# PostgreSQL (hébergeur UE : Scaleway, Clever Cloud…)
DATABASE_URL=postgres://user:password@localhost:5432/abalassembly

# Redis (sessions, rate-limit, leaderboard)
REDIS_URL=redis://localhost:6379

# Secret JWT — générer avec :  openssl rand -hex 32
# Obligatoire : sans lui (ou laissé à cette valeur d'exemple, ou plus court que
# 32 caractères), le serveur refuse de démarrer.
JWT_SECRET=CHANGE_ME_32_bytes_hex_minimum

# Relais devant le serveur (reverse proxy) dont on croit l'en-tête X-Forwarded-For :
# l'adresse ou la plage depuis laquelle il joint le serveur (ex. 127.0.0.1 ; dans la
# pile docker-compose, la passerelle du réseau Docker, souvent 172.16.0.0/12), ou le
# nombre de relais (ex. 1). Vide = on ne croit personne : derrière un relais, toutes
# les requêtes semblent alors venir de lui et partagent une seule limite de débit
# (trop strict, mais jamais contournable). « true » est refusé : ce serait croire
# l'adresse annoncée par n'importe quel client. Voir docs-fr/DEPLOY.fr.md.
TRUST_PROXY=

# Administrateurs : plus de compte admin de démarrage. Le futur admin s'inscrit
# normalement, puis, sur le serveur :  node --env-file=.env scripts/admin.js nommer <email>
# (pile Docker : docker compose exec api node scripts/admin.js nommer <email>)
# Il doit activer la MFA avant toute action d'administration.

# Certificat CA PostgreSQL de l'hébergeur (contenu PEM) — active la vérification
# TLS stricte. À télécharger dans la console Scaleway/Clever. Fortement recommandé.
DATABASE_CA=

# Ordonnanceur (/ordo) : durée du bail d'une mission (s), demi-coups recherchés par le
# serveur pour vérifier chaque partie rendue, durée maximale d'une vérification (ms)
ORDO_BAIL_S=60
ORDO_VERIF_COUPS=3
ORDO_VERIF_DELAI_MS=120000
# Exécutants vivants à la fois pour le compte de calcul (un joueur : 8)
ORDO_EXECUTANTS_CALCUL=64

# Exécutants de calcul en conteneurs (docker compose --profile calcul) : le compte de
# calcul (scripts/admin.js calcul <email>), sans droits d'administration, et les
# cœurs donnés à chaque conteneur. Voir docs-fr/DEPLOY.fr.md.
ABA_CALCUL_EMAIL=
ABA_CALCUL_MDP=
ABA_COEURS=2

# Preuve de travail anti-robot (src/preuve.js) : bits nuls exigés en tête du SHA-256.
# 17 ≈ 130 000 essais : 0,3 s sur un ordinateur, 1 s environ sur un téléphone. +1 = deux fois plus long.
PREUVE_BITS=17
